<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#05070b"/>
      <stop offset="50%" stop-color="#090d15"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6366f1"/>
      <stop offset="100%" stop-color="#a855f7"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <circle cx="950" cy="150" r="280" fill="#4f46e5" opacity="0.12" filter="blur(60px)"/>
  <circle cx="250" cy="480" r="220" fill="#9333ea" opacity="0.08" filter="blur(60px)"/>
  <g transform="translate(100, 160)">
    <rect width="140" height="32" rx="16" fill="#6366f1" fill-opacity="0.15" stroke="#6366f1" stroke-opacity="0.3"/>
    <text x="70" y="21" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="700" fill="#a5b4fc" text-anchor="middle" letter-spacing="2">CINEMA INTELLIGENCE</text>
    <text x="0" y="120" font-family="system-ui, -apple-system, sans-serif" font-size="72" font-weight="900" fill="#ffffff" letter-spacing="-1.5">MOVIEINT</text>
    <text x="0" y="175" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="500" fill="url(#accent)">Narrative DNA &amp; Cinematic Telemetry Engine</text>
    <text x="0" y="240" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="400" fill="#94a3b8">Algorithmic story breakdowns, ending decryptions, and streaming telemetry.</text>
  </g>
  <rect x="100" y="520" width="1000" height="1" fill="#ffffff" fill-opacity="0.08"/>
  <text x="100" y="555" font-family="monospace" font-size="16" fill="#64748b">movieint.com</text>
</svg>