er gap-2 py-0.5\"><span class=\"text-cyan-500\">#<!-- -->2</span><span>Shutter Island<!-- --> (<!-- -->2010<!-- -->)</span><span class=\"text-amber-400 ml-auto font-semibold\">DNA <!-- -->8.7</span></a></li></ul></div><section class=\"space-y-12\"><div id=\"movie-496243\" class=\"scroll-mt-20 rounded-2xl bg-[#0b0e17] border border-slate-800 p-6 sm:p-8 hover:border-slate-700 transition-all shadow-xl\"><div class=\"flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-slate-800/80 pb-5 mb-6\"><div><div class=\"flex items-center gap-2 mb-1\"><span class=\"text-cyan-400 font-mono font-bold text-sm\">ENTRY #<!-- -->1</span><span class=\"text-slate-500 text-xs font-mono\">•</span><span class=\"text-slate-400 text-xs font-mono\">2019</span><span class=\"text-slate-500 text-xs font-mono\">•</span><span class=\"text-slate-400 text-xs font-mono\">132 min</span></div><h3 class=\"text-2xl sm:text-3xl font-bold text-white\"><a class=\"hover:text-cyan-300 transition-colors inline-flex items-center gap-2\" href=\"/movie/496243\">Parasite<svg class=\"w-5 h-5 text-cyan-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\"></path></svg></a></h3><p class=\"text-xs font-mono text-slate-400 mt-1\">Directed by <span class=\"text-slate-300\">Bong Joon-ho</span> | Genres: <!-- -->Thriller, Drama, Black Comedy</p></div><div class=\"flex sm:flex-col items-center sm:items-end justify-between sm:justify-center p-3 rounded-lg bg-slate-900 border border-slate-700/60 font-mono\"><span class=\"text-[10px] uppercase tracking-wider text-slate-400\">MOVIEINT DNA</span><span class=\"text-2xl font-black text-cyan-400\">9.5</span><span class=\"text-[10px] text-slate-500\">Telemetry v3.2</span></div></div><div class=\"grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-xl bg-slate-950/60 border border-slate-800/80